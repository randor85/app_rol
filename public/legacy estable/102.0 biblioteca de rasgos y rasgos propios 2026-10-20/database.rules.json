{
  "rules": {
    "lista_campanas": {
      // v99.0: la lista de campañas YA NO se puede enumerar (no hay ".read" en la raíz); se lee una campaña por su id (para unirse por
      // ID o por invitación) y cada quien ve en su menú solo las suyas (usuarios/<uid>/campanas). Cada campaña tiene creador, nombre y sistema.
      "$campanaId": {
        ".read": "auth != null",
        "creador": {
          // La primera persona que escribe el id es la creadora (y la primera integrante); el id no se puede volver a tomar.
          ".write": "auth != null && !data.exists() && newData.val() == auth.uid",
          ".validate": "newData.isString() && $campanaId.matches(/^[a-z0-9_-]{3,40}$/)"
        },
        "nombre": {
          ".write": "auth != null && ( (!data.exists() && root.child('lista_campanas').child($campanaId).child('creador').val() == auth.uid) || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) )",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "sistema": {
          // Sistema de juego ('dnd', 'coc' o 'chicle'): lo fija quien crea la campaña y después solo lo cambia el GM o el GM de apoyo.
          ".write": "auth != null && ( (!data.exists() && root.child('lista_campanas').child($campanaId).child('creador').val() == auth.uid) || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) )",
          ".validate": "newData.val() == 'dnd' || newData.val() == 'coc' || newData.val() == 'chicle'"
        },
        "privada": {
          // v101.0: campaña privada = solo se entra con invitación (no se aceptan solicitudes por id) y no aparece en el buscador. Sin este
          // campo la campaña es pública. La fija quien crea la campaña y después la cambian el GM o el GM de apoyo.
          ".write": "auth != null && ( (!data.exists() && root.child('lista_campanas').child($campanaId).child('creador').val() == auth.uid) || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) )",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "usuarios": {
      "$uid": {
        // Datos propios (personajes sin campaña) e índice de mis campañas. El GM de una campaña también escribe la entrada de esa campaña
        // (al aprobar una solicitud o quitar a alguien), nunca otras.
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        // Perfil propio (v100.0): nombre de usuario (por defecto el de Google; editable) y si aparece en el buscador de campañas.
        "perfil": {
          "nombre": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "visible": { ".validate": "newData.isBoolean()" },
          "$otro": { ".validate": false }
        },
        "campanas": {
          "$campanaId": {
            ".write": "auth != null && ( auth.uid == $uid || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) )",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "directorio": {
      // Buscador de campañas por jugador (v100.0). Lo ve cualquier cuenta con sesión; cada quien escribe solo su ficha de directorio y solo
      // puede listar campañas donde de verdad es integrante (rol 'gm' solo si es titular o apoyo). El GM de una campaña puede borrar su
      // entrada de la lista de alguien al sacarlo. Quien no quiera aparecer borra su entrada (casilla «Aparecer en el buscador»).
      ".read": "auth != null",
      ".indexOn": ["nombre_lc"],
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['nombre', 'nombre_lc'])",
        "nombre": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "nombre_lc": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "campanas": {
          "$campanaId": {
            ".write": "auth != null && !newData.exists() && (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true)",
            ".validate": "root.child('lista_campanas').child($campanaId).child('privada').val() != true && ((newData.val() == 'gm' && (root.child('campanas').child($campanaId).child('gm').val() == $uid || root.child('campanas').child($campanaId).child('gm_apoyo').child($uid).val() === true)) || (newData.val() == 'jugador' && root.child('campanas').child($campanaId).child('miembros').child($uid).exists()))"
          }
        },
        "$otro": { ".validate": false }
      }
    },
    "acceso": {
      // Secretos y trámites de acceso de cada campaña, FUERA de campanas/<id> a propósito: lo que cuelga de campanas/<id> lo leen todos los
      // integrantes, y estos nodos no (la clave de GM, las invitaciones, las solicitudes).
      "$campanaId": {
        "gm_hash": {
          // Hash PBKDF2 de la clave de GM. Nadie lo lee desde el cliente; solo lo comparan las reglas del nodo 'gm'.
          ".read": false,
          ".write": "auth != null && ( (!data.exists() && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists()) || root.child('campanas').child($campanaId).child('gm').val() == auth.uid )",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "gm_claim": {
          // Cada integrante escribe aquí SU hash al reclamar un puesto de GM vacante; solo él lo lee o escribe.
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "notas_gm": {
          // Notas secretas del GM (pantalla del director): solo el GM y su apoyo las leen y escriben.
          ".read": "auth != null && (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true)",
          ".write": "auth != null && (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true)",
          ".validate": "newData.isString() && newData.val().length <= 20000"
        },
        "invitaciones": {
          // Invitaciones (clave larga al azar): las crea y revoca el GM o el GM de apoyo; solo ellos las leen.
          ".read": "auth != null && (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true)",
          "$token": {
            ".write": "auth != null && (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['expira', 'por']) && newData.child('expira').isNumber() && newData.child('por').val() == auth.uid && $token.matches(/^[a-zA-Z0-9]{16,64}$/)"
          }
        },
        "canjes": {
          // Quien tiene una invitación escribe aquí la clave y, con ella, se agrega a miembros (las reglas comprueban que exista y no haya vencido).
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isString() && newData.val().length <= 64"
          }
        },
        "solicitudes": {
          // Solicitudes para entrar por el id de la campaña: las escribe quien quiere entrar; las lee y resuelve el GM o el GM de apoyo.
          ".read": "auth != null && (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true)",
          "$uid": {
            ".write": "auth != null && ( (auth.uid == $uid && (!newData.exists() || root.child('lista_campanas').child($campanaId).child('privada').val() != true)) || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) )",
            ".validate": "newData.hasChildren(['nombre', 'ts']) && newData.child('nombre').isString() && newData.child('nombre').val().length <= 80 && newData.child('ts').isNumber()"
          }
        }
      }
    },
    "biblioteca": {
      // Biblioteca GLOBAL (compartida entre campañas): clases y subclases custom (creador-clases.html / clases-custom.js), para
      // crearlas una vez y reutilizarlas en campañas futuras. Las lee cualquier usuario autenticado; cada subclase es un nodo
      // por id (slug 'c_...'): se puede CREAR una nueva y solo su autor (campo 'autor') puede EDITARLA o BORRARLA.
      "clases_custom": {
        // Clases homebrew GLOBALES (compartidas entre campañas). Se puede CREAR una nueva y solo su autor (campo 'autor') puede EDITARLA o BORRARLA.
        ".read": "auth != null",
        "$claseId": {
          ".write": "auth != null && ( !data.exists() || data.child('autor').val() == auth.uid )",
          ".validate": "newData.hasChildren(['id', 'name', 'hitDie', 'autor']) && newData.child('id').val() == $claseId && $claseId.matches(/^c_[a-z0-9_]{1,40}$/) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 60 && (newData.child('hitDie').val() == 6 || newData.child('hitDie').val() == 8 || newData.child('hitDie').val() == 10 || newData.child('hitDie').val() == 12) && (!newData.child('casterType').exists() || newData.child('casterType').val() == 'full' || newData.child('casterType').val() == 'half' || newData.child('casterType').val() == 'pact') && newData.child('autor').isString() && ( (data.exists() && data.child('autor').exists()) ? newData.child('autor').val() == data.child('autor').val() : newData.child('autor').val() == auth.uid )"
        }
      },
      "subclases_custom": {
        ".read": "auth != null",
        "$subclaseId": {
          ".write": "auth != null && ( !data.exists() || data.child('autor').val() == auth.uid )",
          ".validate": "newData.hasChildren(['id', 'clase', 'name', 'autor']) && newData.child('id').val() == $subclaseId && $subclaseId.matches(/^c_[a-z0-9_]{1,40}$/) && newData.child('clase').isString() && newData.child('clase').val().matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 80 && newData.child('autor').isString() && ( (data.exists() && data.child('autor').exists()) ? newData.child('autor').val() == data.child('autor').val() : newData.child('autor').val() == auth.uid )"
        }
      }
    },
    "campanas": {
      "$campanaId": {
        // v99.0: SOLO las personas integrantes (campanas/<id>/miembros/<uid>) leen la campaña. Este ".read" cubre todo lo que cuelga de aquí, por eso
        // los secretos viven en acceso/<id> y no en este árbol.
        ".read": "auth != null && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists()",
        "miembros": {
          "$uid": {
            ".write": "auth != null && ( (auth.uid == $uid && !data.exists() && newData.exists() && ( (!root.child('campanas').child($campanaId).child('miembros').exists() && root.child('lista_campanas').child($campanaId).child('creador').val() == auth.uid) || root.child('acceso').child($campanaId).child('invitaciones').child(root.child('acceso').child($campanaId).child('canjes').child(auth.uid).val()).child('expira').val() > now )) || (auth.uid == $uid && data.exists() && newData.exists()) || (auth.uid == $uid && data.exists() && !newData.exists() && root.child('campanas').child($campanaId).child('gm').val() != auth.uid) || ((root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) && $uid != root.child('campanas').child($campanaId).child('gm').val()) )",
            ".validate": "newData.hasChildren(['nombre']) && newData.child('nombre').isString() && newData.child('nombre').val().length <= 80"
          }
        },
        "gm": {
          // GM titular. Se reclama solo si está vacante, es tu uid, eres integrante y, si la campaña tiene clave (acceso/<id>/gm_hash), tu
          // acceso/<id>/gm_claim/<uid> coincide con ese hash. Quien es GM puede soltarlo o cederlo.
          ".write": "auth != null && ( (data.exists() && data.val() == auth.uid) || (!data.exists() && newData.val() == auth.uid && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists() && ( !root.child('acceso').child($campanaId).child('gm_hash').exists() || root.child('acceso').child($campanaId).child('gm_claim').child(auth.uid).val() == root.child('acceso').child($campanaId).child('gm_hash').val() )) )"
        },
        "gm_apoyo": {
          // GM DE APOYO: facultades de GM salvo compartir o quitar el rol. Solo el titular lo agrega o quita (a integrantes); cada apoyo puede quitarse.
          ".write": "auth != null && root.child('campanas').child($campanaId).child('gm').val() == auth.uid",
          "$uid": {
            ".write": "auth != null && ( root.child('campanas').child($campanaId).child('gm').val() == auth.uid || (auth.uid == $uid && !newData.exists()) )",
            ".validate": "newData.val() === true && root.child('campanas').child($campanaId).child('miembros').child($uid).exists()"
          }
        },
        "gm_salt": {
          // Sal pública de la clave de GM (el cliente la necesita para calcular el hash).
          ".write": "auth != null && (!data.exists() || root.child('campanas').child($campanaId).child('gm').val() == auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "bitacora": {
          ".write": "auth != null && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists()"
        },
        "tiradas": {
          ".write": "auth != null && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists()"
        },
        "clases_custom": {
          // Clases homebrew antiguas de la campaña (hoy se crean en la biblioteca global).
          "$claseId": {
            ".write": "auth != null && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists() && ( !data.exists() || data.child('autor').val() == auth.uid || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) )",
            ".validate": "newData.hasChildren(['id', 'name', 'hitDie', 'autor']) && newData.child('id').val() == $claseId && $claseId.matches(/^c_[a-z0-9_]{1,40}$/) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 60 && (newData.child('hitDie').val() == 6 || newData.child('hitDie').val() == 8 || newData.child('hitDie').val() == 10 || newData.child('hitDie').val() == 12) && (!newData.child('casterType').exists() || newData.child('casterType').val() == 'full' || newData.child('casterType').val() == 'half' || newData.child('casterType').val() == 'pact') && newData.child('autor').isString() && ( (data.exists() && data.child('autor').exists()) ? newData.child('autor').val() == data.child('autor').val() : newData.child('autor').val() == auth.uid )"
          }
        },
        "subclases_custom": {
          "$subclaseId": {
            ".write": "auth != null && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists() && ( !data.exists() || data.child('autor').val() == auth.uid || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) )",
            ".validate": "newData.hasChildren(['id', 'clase', 'name', 'autor']) && newData.child('id').val() == $subclaseId && $subclaseId.matches(/^c_[a-z0-9_]{1,40}$/) && newData.child('clase').isString() && newData.child('clase').val().matches(/^[a-z0-9_]{1,40}$/) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 80 && newData.child('autor').isString() && ( (data.exists() && data.child('autor').exists()) ? newData.child('autor').val() == data.child('autor').val() : newData.child('autor').val() == auth.uid )"
          }
        },
        "party": {
          // Resumen de cada personaje para el visor del grupo: lo escribe el dueño o el GM.
          "$personajeId": {
            ".write": "auth != null && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists() && ( root.child('campanas').child($campanaId).child('personajes').child($personajeId).child('owner').val() == auth.uid || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) )"
          }
        },
        "personajes": {
          "$personajeId": {
            // Escribe: el dueño registrado, el GM (o su apoyo), o quien reclama un personaje sin dueño poniéndose como dueño. Siempre integrante.
            ".write": "auth != null && root.child('campanas').child($campanaId).child('miembros').child(auth.uid).exists() && ( (data.child('owner').exists() && data.child('owner').val() == auth.uid) || (root.child('campanas').child($campanaId).child('gm').val() == auth.uid || root.child('campanas').child($campanaId).child('gm_apoyo').child(auth.uid).val() === true) || (!data.child('owner').exists() && newData.child('owner').val() == auth.uid) )"
          }
        }
      }
    }
  }
}
